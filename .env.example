# In Replit, store provider credentials and Telegram destination links in Secrets.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_URL=
TELEGRAM_GROUP_URL=

# Public @channel username or numeric channel ID (for example, -1001234567890).
TELEGRAM_CHAT_ID=

# Optional additional group or channel where each story is also published.
TELEGRAM_ADDITIONAL_CHAT_ID=@baslmahmod

# Optional settings
OPENROUTER_MODEL=openai/gpt-4o-mini
POLL_INTERVAL_MINUTES=15
MAX_ARTICLE_AGE_HOURS=72
FETCH_TIMEOUT_SECONDS=20
PUBLISH_TIMEZONE=Asia/Jerusalem
PUBLISH_START_HOUR=8
PUBLISH_END_HOUR=22
DATABASE_PATH=data/tekz_auto_news.db
RSS_SOURCES_PATH=rss_sources.json
LOG_LEVEL=INFO