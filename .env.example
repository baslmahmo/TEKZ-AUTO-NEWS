# Add OPENROUTER_API_KEY and TELEGRAM_BOT_TOKEN to Replit Secrets, not this file.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Public @channel username or numeric channel ID (for example, -1001234567890).
TELEGRAM_CHAT_ID=

# Optional settings
OPENROUTER_MODEL=openai/gpt-4o-mini
POLL_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_CYCLE=3
MAX_ARTICLE_AGE_HOURS=72
FETCH_TIMEOUT_SECONDS=20
DATABASE_PATH=data/tekz_auto_news.db
RSS_SOURCES_PATH=rss_sources.json
LOG_LEVEL=INFO